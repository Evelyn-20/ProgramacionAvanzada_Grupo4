@*
    Layout PDF para Rotativa
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Pastelería Artesanal</title>

    <!-- Tipografías -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            margin: 20px;
            color: #333;
        }

        .empresa-header {
            text-align: center;
            margin-bottom: 25px;
        }

            .empresa-header img {
                height: 70px;
                margin-bottom: 5px;
            }

            .empresa-header h2 {
                font-family: 'Playfair Display', serif;
                margin-bottom: 2px;
            }

            .empresa-header p {
                margin: 0;
                font-size: 12px;
            }

        h3.reporte-title {
            text-align: center;
            font-family: 'Playfair Display', serif;
            margin-bottom: 20px;
            color: #444;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1rem;
        }

        th, td {
            padding: 8px 10px;
            text-align: left;
        }

        th {
            background-color: #f9a825; /* color cálido para cabecera */
            color: #fff;
            font-weight: 600;
        }

        tr:nth-child(even) {
            background-color: #fff3e0; /* filas alternadas suaves */
        }

        tr:nth-child(odd) {
            background-color: #fff8e1;
        }

        tfoot td {
            font-weight: bold;
            background-color: #ffe082;
        }

        .datos-empresa {
            margin-bottom: 20px;
            font-size: 11px;
            line-height: 1.4;
        }

            .datos-empresa span {
                display: block;
            }
    </style>
</head>
<body>
    <div class="empresa-header">
        <img src="~/images/logo.png" alt="Pastelería Artesanal" />
        <h2>Pastelería Artesanal</h2>
        <p>Reporte de Ventas</p>
    </div>

    <div class="datos-empresa">
        <span><strong>Dirección:</strong> San José, Costa Rica</span>
        <span><strong>Teléfono:</strong> +506 1234-5678</span>
        <span><strong>Email:</strong> info@pasteleria.com</span>
    </div>

    <main>
        @RenderBody()
    </main>
</body>
</html>
