@model List<Pasteleria.Abstracciones.ModeloUI.Producto>

@{
    ViewBag.Title = "Inventario";

    // Permisos basados en la tabla
    var tipoUsuario = User.FindFirst("TipoUsuario")?.Value;

    // Ver Inventario: Admin, Operaciones, Supervisor, Operador
    var puedeVerInventario = tipoUsuario == "Administrador" ||
                             tipoUsuario == "Operaciones" ||
                             tipoUsuario == "Supervisor" ||
                             tipoUsuario == "Operador";

    // Crear: Solo Admin
    var puedeCrear = tipoUsuario == "Administrador";

    // Editar Stock: Admin, Operaciones, Supervisor, Operador
    var puedeEditarStock = tipoUsuario == "Administrador" ||
                           tipoUsuario == "Operaciones" ||
                           tipoUsuario == "Supervisor" ||
                           tipoUsuario == "Operador";

    // Editar Todo: Solo Admin
    var puedeEditarTodo = tipoUsuario == "Administrador";

    // Eliminar: Solo Admin
    var puedeEliminar = tipoUsuario == "Administrador";
}

<!-- Banner Hero -->
<section class="hero" style="padding: 3rem 0;">
    <div class="hero-content">
        <h1 class="hero-title">Inventario</h1>
        <p class="hero-subtitle">Administra y visualiza todo el inventario de productos</p>
    </div>
</section>

<div class="container" style="padding: 3rem 20px; max-width: 1400px;">

    @if (!puedeVerInventario)
    {
        <div class="alert alert-warning" role="alert" style="border-radius: 10px; margin-bottom: 2rem;">
            <i class="fas fa-exclamation-circle"></i> No tienes permisos para ver el inventario.
        </div>
        return;
    }

    <!-- Barra de búsqueda y botón agregar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap;">
        <form method="get" action="@Url.Action("ListadoProductos", "Producto")" style="position: relative; flex: 1; min-width: 300px; display: flex; gap: 0.5rem;">
            <div style="position: relative; flex: 1;">
                <i class="fas fa-search" style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: var(--primary-color); z-index: 1;"></i>
                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       placeholder="Buscar por nombre, descripción, precio, cantidad o ID..."
                       style="width: 100%; padding: 1rem 1rem 1rem 50px; border: 2px solid var(--secondary-color); border-radius: 50px; font-size: 1rem; background: var(--white); transition: all 0.3s;">
            </div>
            <button type="submit" class="btn btn-primary" style="border-radius: 50px; padding: 0 2rem; white-space: nowrap;">
                <i class="fas fa-search"></i> Buscar
            </button>
        </form>

        @* Botón Crear: Solo Admin *@
        @if (puedeCrear)
        {
            <a href="@Url.Action("CrearProducto", "Producto")" class="btn btn-primary" style="white-space: nowrap;">
                <i class="fas fa-plus"></i> Agregar Producto
            </a>
        }
    </div>

    <!-- Información de búsqueda -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
    {
        <div style="background: var(--light-color); padding: 1rem 1.5rem; border-radius: 10px; margin-bottom: 1.5rem; border-left: 4px solid var(--primary-color);">
            <p style="margin: 0; color: var(--text-color);">
                <i class="fas fa-info-circle" style="color: var(--primary-color);"></i>
                Mostrando resultados para <strong style="color: var(--primary-color);">"@ViewBag.Buscar"</strong>
                - <strong>@(Model?.Count ?? 0)</strong> producto(s) encontrado(s)
            </p>
        </div>
    }

    <!-- Filtro por categoría -->
    <div style="margin-bottom: 2rem;">
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
            <span style="color: var(--text-color); font-weight: 600; margin-right: 0.5rem;">
                <i class="fas fa-filter" style="color: var(--primary-color);"></i> Filtrar por categoría:
            </span>
            <a href="@Url.Action("ListadoProductos", "Producto")"
               class="btn btn-primary"
               style="border-radius: 50px; padding: 0.6rem 1.5rem; font-size: 0.9rem; @(ViewBag.Categoria == null && string.IsNullOrWhiteSpace(ViewBag.Buscar as string) ? "" : "background: transparent; color: var(--primary-color); border: 2px solid var(--primary-color);")">
                <i class="fas fa-th"></i> Todas
            </a>

            @if (ViewBag.TodasCategorias != null)
            {
                @foreach (var categoria in (List<Pasteleria.Abstracciones.ModeloUI.Categoria>)ViewBag.TodasCategorias)
                {
                    <a href="@Url.Action("ListadoProductos", "Producto", new { categoria = categoria.IdCategoria })"
                       class="btn btn-primary"
                       style="border-radius: 50px; padding: 0.6rem 1.5rem; font-size: 0.9rem; @(ViewBag.Categoria == categoria.IdCategoria ? "" : "background: transparent; color: var(--primary-color); border: 2px solid var(--primary-color);")">
                        @categoria.NombreCategoria
                    </a>
                }
            }
        </div>
    </div>

    <!-- Tabla con estilo mejorado -->
    <div style="background: var(--white); border-radius: 15px; box-shadow: var(--shadow); overflow: hidden;">
        <div class="table-responsive">
            <table id="laTablaDeProductos" style="margin-bottom: 0; width: 100%; border-collapse: collapse;">
                <thead style="background: linear-gradient(135deg, var(--secondary-color) 0%, #e8d4bc 100%);">
                    <tr>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">#</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Imagen</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Nombre</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Categoría</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Descripción</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Cantidad</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Precio</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Descuento</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Impuesto</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Estado</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var producto in Model)
                        {
                            <tr style="border-bottom: 1px solid var(--secondary-color); transition: background 0.3s;">
                                <td style="padding: 1.2rem; color: var(--text-color);">@producto.IdProducto</td>
                                <td style="padding: 1.2rem;">
                                    <img src="@Url.Action("ObtenerThumbnailProducto", "Producto", new { id = producto.IdProducto })"
                                         alt="@producto.NombreProducto" loading="lazy"
                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px; box-shadow: var(--shadow);">
                                </td>
                                <td style="padding: 1.2rem; color: var(--dark-color); font-weight: 500;">@producto.NombreProducto</td>
                                <td style="padding: 1.2rem; color: var(--text-color);">
                                    @{
                                        var nombreCategoria = "Sin categoría";
                                        if (ViewBag.TodasCategorias != null)
                                        {
                                            var categoriaProducto = ((List<Pasteleria.Abstracciones.ModeloUI.Categoria>)ViewBag.TodasCategorias)
                                            .FirstOrDefault(c => c.IdCategoria == producto.IdCategoria);
                                            if (categoriaProducto != null)
                                            {
                                                nombreCategoria = categoriaProducto.NombreCategoria;
                                            }
                                            else
                                            {
                                                nombreCategoria = $"Categoría {producto.IdCategoria}";
                                            }
                                        }
                                    }
                                    @nombreCategoria
                                </td>
                                <td style="padding: 1.2rem; color: var(--text-color); max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @producto.DescripcionProducto
                                </td>
                                <td style="padding: 1.2rem; color: var(--text-color);">@producto.Cantidad</td>
                                <td style="padding: 1.2rem;">
                                    @if (producto.TieneDescuento)
                                    {
                                        <!-- Precio con descuento -->
                                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                            <span style="color: var(--text-color); font-size: 0.85rem; text-decoration: line-through; opacity: 0.7;">
                                                ₡@producto.Precio.ToString("N2")
                                            </span>
                                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                                <span style="color: var(--primary-color); font-weight: 700; font-size: 1.1rem;">
                                                    ₡@producto.PrecioConDescuento.ToString("N2")
                                                </span>
                                                <span style="background: #27ae60; color: white; padding: 0.2rem 0.5rem; border-radius: 5px; font-size: 0.75rem; font-weight: 600;">
                                                    -@producto.PorcentajeDescuento%
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Precio sin descuento -->
                                        <span style="color: var(--primary-color); font-weight: 600;">₡@producto.Precio.ToString("N2")</span>
                                    }
                                </td>
                                <td style="padding: 1.2rem; color: var(--text-color);">
                                    @if (producto.TieneDescuento)
                                    {
                                        <span style="background: #27ae60; color: white; padding: 0.4rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block;">
                                            @producto.PorcentajeDescuento%
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-color); opacity: 0.5;">Sin descuento</span>
                                    }
                                </td>
                                <td style="padding: 1.2rem; color: var(--text-color);">@producto.PorcentajeImpuesto%</td>
                                <td style="padding: 1.2rem;">
                                    @if (producto.Estado)
                                    {
                                        <span style="background: #27ae60; color: var(--white); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block;">Activo</span>
                                    }
                                    else
                                    {
                                        <span style="background: #e74c3c; color: var(--white); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block;">Inactivo</span>
                                    }
                                </td>
                                <td style="padding: 1.2rem; text-align: center; white-space: nowrap;">
                                    @* Botón Editar: Admin (todo) u Operaciones (solo stock) *@
                                    @if (puedeEditarStock)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-editar"
                                                data-id="@producto.IdProducto"
                                                style="background: var(--primary-color); color: var(--white); border: none; margin: 0 0.25rem; cursor: pointer;"
                                                title="@(puedeEditarTodo ? "Editar producto" : "Editar stock")">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    }

                                    @* Botón Ver Detalles: Todos los que pueden ver inventario *@
                                    <button type="button"
                                            class="btn btn-sm btn-detalles"
                                            data-id="@producto.IdProducto"
                                            data-nombre="@producto.NombreProducto"
                                            data-categoria="@nombreCategoria"
                                            data-descripcion="@producto.DescripcionProducto"
                                            data-cantidad="@producto.Cantidad"
                                            data-precio="@producto.Precio.ToString("N2")"
                                            data-descuento="@(producto.PorcentajeDescuento ?? 0)"
                                            data-precio-descuento="@producto.PrecioConDescuento.ToString("N2")"
                                            data-impuesto="@producto.PorcentajeImpuesto"
                                            data-estado="@(producto.Estado ? "Activo" : "Inactivo")"
                                            data-fecha-creacion="@producto.FechaCreacionFormateada"
                                            data-fecha-actualizacion="@producto.FechaActualizacionFormateada"
                                            style="background: #3498db; color: var(--white); border: none; margin: 0 0.25rem; cursor: pointer;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalDetallesProducto"
                                            title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </button>

                                    @* Botón Eliminar: Solo Admin *@
                                    @if (puedeEliminar)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-eliminar"
                                                data-id="@producto.IdProducto"
                                                data-nombre="@producto.NombreProducto"
                                                data-categoria="@nombreCategoria"
                                                data-descripcion="@producto.DescripcionProducto"
                                                data-cantidad="@producto.Cantidad"
                                                data-precio="@producto.Precio.ToString("N2")"
                                                data-estado="@(producto.Estado ? "Activo" : "Inactivo")"
                                                style="background: #e74c3c; color: var(--white); border: none; margin: 0 0.25rem; cursor: pointer;"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminarProducto"
                                                title="Eliminar producto">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <!-- Footer de paginación -->
            <div style="padding: 1.5rem; background: var(--light-color); display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--secondary-color); flex-wrap: wrap; gap: 1rem;">
                <div style="color: var(--text-color); font-size: 0.95rem;">
                    Mostrando <strong><span id="startRecord">1</span>-<span id="endRecord">@Math.Min(10, Model.Count)</span></strong> de <strong id="totalRecords">@Model.Count</strong> productos
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button id="btnAnterior"
                            class="btn"
                            onclick="paginaAnterior()"
                            style="border-radius: 50px; background: transparent; color: var(--primary-color); border: 2px solid var(--primary-color); padding: 0.8rem 2rem;">
                        &lt; Anterior
                    </button>
                    <button id="btnSiguiente"
                            class="btn"
                            onclick="paginaSiguiente()"
                            style="border-radius: 50px; background: var(--primary-color); color: var(--white); border: none; padding: 0.8rem 2rem;">
                        Siguiente &gt;
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<partial name="_ModalDetallesProducto" />
@if (puedeEliminar)
{
    <partial name="_ModalEliminarProducto" />
}

@section Scripts {
    <script src="~/js/producto.js"></script>

    <script>
        // Modal de notificación automático
        document.addEventListener('DOMContentLoaded', function() {
            function mostrarNotificacion(mensaje, tipo) {
                const iconos = {
                    'success': 'fa-check-circle',
                    'error': 'fa-exclamation-triangle'
                };

                const colores = {
                    'success': '#27ae60',
                    'error': '#e74c3c'
                };

                const modalHtml = `
                    <div class="modal fade" id="modalNotificacion" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content" style="border: none; border-radius: 15px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
                                <div class="modal-body" style="padding: 2rem; text-align: center; background: white;">
                                    <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: ${colores[tipo]}; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas ${iconos[tipo]}" style="font-size: 2.5rem; color: white;"></i>
                                    </div>
                                    <h5 style="color: #2c3e50; margin-bottom: 1rem; font-weight: 600;">${mensaje}</h5>
                                    <div style="width: 100%; height: 4px; background: #e0e0e0; border-radius: 2px; overflow: hidden; margin-top: 1.5rem;">
                                        <div id="barraProgreso" style="width: 100%; height: 100%; background: ${colores[tipo]}; transition: width 3s linear;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                const modalAnterior = document.getElementById('modalNotificacion');
                if (modalAnterior) {
                    modalAnterior.remove();
                }

                document.body.insertAdjacentHTML('beforeend', modalHtml);

                const modalElement = document.getElementById('modalNotificacion');
                const modal = new bootstrap.Modal(modalElement);
                modal.show();

                setTimeout(function () {
                    const barra = document.getElementById('barraProgreso');
                    if (barra) {
                        barra.style.width = '0%';
                    }
                }, 100);

                setTimeout(function () {
                    modal.hide();
                    setTimeout(function () {
                        modalElement.remove();
                    }, 300);
                }, 3000);
            }

            // Verificar mensajes de TempData
            @if (TempData["Success"] != null)
            {
                            <text>mostrarNotificacion('@TempData["Success"]', 'success');</text>
            }

            @if (TempData["Error"] != null)
            {
                            <text>mostrarNotificacion('@TempData["Error"]', 'error');</text>
            }
        });
    </script>
}