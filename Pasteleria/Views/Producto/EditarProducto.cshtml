@model Pasteleria.Abstracciones.ModeloUI.Producto

@{
    ViewBag.Title = "Actualizar Producto";

    // Permisos
    var tipoUsuario = User.FindFirst("TipoUsuario")?.Value;
    var esAdmin = tipoUsuario == "Administrador";
    var esOperaciones = tipoUsuario == "Operaciones" || tipoUsuario == "Operador";
    var esSupervisor = tipoUsuario == "Supervisor";

    // Operaciones solo puede editar stock
    var soloStock = esOperaciones && !esAdmin && !esSupervisor;
}

<!-- Banner Hero -->
<section class="hero" style="padding: 3rem 0;">
    <div class="hero-content">
        <h1 class="hero-title">@(soloStock ? "Actualizar Stock" : "Actualizar Producto")</h1>
        <p class="hero-subtitle">@(soloStock ? "Modifica la cantidad en inventario" : "Modifica la información del producto")</p>
    </div>
</section>

<div class="container" style="padding: 3rem 20px; max-width: 800px;">
    @if (soloStock)
    {
        <div class="alert alert-info" role="alert" style="border-radius: 10px; margin-bottom: 2rem;">
            <i class="fas fa-info-circle"></i> Como usuario de Operaciones, solo puedes modificar la cantidad en stock.
        </div>
    }

    @using (Html.BeginForm("EditarProducto", "Producto", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.IdProducto)
        @Html.HiddenFor(model => model.FechaCreacion)
        @Html.HiddenFor(model => model.FechaActualizacion)

        @if (soloStock)
        {
            @Html.HiddenFor(model => model.NombreProducto)
            @Html.HiddenFor(model => model.IdCategoria)
            @Html.HiddenFor(model => model.DescripcionProducto)
            @Html.HiddenFor(model => model.Precio)
            @Html.HiddenFor(model => model.PorcentajeImpuesto)
            @Html.HiddenFor(model => model.Estado)
        }

        <div style="background: var(--white); border-radius: 15px; box-shadow: var(--shadow); overflow: hidden;">
            <!-- Header del formulario -->
            <div style="background: linear-gradient(135deg, var(--secondary-color) 0%, #e8d4bc 100%); padding: 1.5rem 2rem;">
                <h4 style="color: var(--dark-color); margin: 0; font-weight: 600;">
                    <i class="fas fa-edit" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    @(soloStock ? "Ajuste de Inventario" : "Datos del Producto")
                </h4>
            </div>

            <!-- Cuerpo del formulario -->
            <div style="padding: 2rem;">
                @Html.ValidationSummary(true, "Por favor, corrige los siguientes errores:", new { @class = "alert alert-danger", style = "margin-bottom: 1.5rem; padding: 1rem; border-radius: 10px; background: #fee; border: 1px solid #fcc; color: #c33;" })

                @if (soloStock)
                {
                    <!-- Vista de solo lectura para Operaciones -->
                    <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--light-color); border-radius: 10px;">
                        <label style="display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;">Producto</label>
                        <p style="margin: 0; font-size: 1.1rem; color: var(--dark-color); font-weight: 600;">@Model.NombreProducto</p>
                    </div>

                    <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--light-color); border-radius: 10px;">
                        <label style="display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;">Descripción</label>
                        <p style="margin: 0; color: var(--text-color);">@Model.DescripcionProducto</p>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                        <div style="padding: 1rem; background: var(--light-color); border-radius: 10px;">
                            <label style="display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;">Precio</label>
                            <p style="margin: 0; color: var(--primary-color); font-weight: 600; font-size: 1.2rem;">₡@Model.Precio.ToString("N2")</p>
                        </div>
                        <div style="padding: 1rem; background: var(--light-color); border-radius: 10px;">
                            <label style="display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;">Stock Actual</label>
                            <p style="margin: 0; color: var(--dark-color); font-weight: 600; font-size: 1.2rem;">@Model.Cantidad unidades</p>
                        </div>
                    </div>

                    <!-- Campo editable: Cantidad -->
                    <div style="margin-bottom: 1.5rem; padding: 1.5rem; background: #e8f5e9; border: 2px solid #27ae60; border-radius: 10px;">
                        @Html.LabelFor(model => model.Cantidad, "Nueva Cantidad en Stock", new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 600; font-size: 1.1rem;" })
                        @Html.EditorFor(model => model.Cantidad, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", placeholder = "0", style = "width: 100%; padding: 0.8rem 1rem; border: 2px solid #27ae60; border-radius: 10px; font-size: 1.2rem; transition: all 0.3s; font-weight: 600;" } })
                        @Html.ValidationMessageFor(model => model.Cantidad, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                        <small style="display: block; margin-top: 0.5rem; color: #2e7d32; font-size: 0.85rem;">
                            <i class="fas fa-info-circle"></i> Ingresa la nueva cantidad disponible en inventario
                        </small>
                    </div>
                }
                else
                {
                    <!-- Formulario completo para Admin y Supervisor -->
                    <!-- Nombre del Producto -->
                    <div style="margin-bottom: 1.5rem;">
                        @Html.LabelFor(model => model.NombreProducto, new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;" })
                        @Html.EditorFor(model => model.NombreProducto, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: Pastel de Chocolate", style = "width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s;" } })
                        @Html.ValidationMessageFor(model => model.NombreProducto, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                    </div>

                    <!-- Categoría -->
                    <div style="margin-bottom: 1.5rem;">
                        @Html.LabelFor(model => model.IdCategoria, "Categoría", new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;" })

                        @if (ViewBag.Categorias != null && ((List<Pasteleria.Abstracciones.ModeloUI.Categoria>)ViewBag.Categorias).Count > 0)
                        {
                            @Html.DropDownListFor(model => model.IdCategoria,
                            new SelectList((List<Pasteleria.Abstracciones.ModeloUI.Categoria>)ViewBag.Categorias, "IdCategoria", "NombreCategoria", Model.IdCategoria),
                                new { @class = "form-control", style = "width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s;" })
                                }
                        else
                        {
                            <select name="IdCategoria" class="form-control" style="width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s;">
                                <option value="@Model.IdCategoria">Categoría actual (ID: @Model.IdCategoria)</option>
                            </select>
                            <small style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.3rem; display: block;">
                                <i class="fas fa-exclamation-circle"></i> No hay categorías activas disponibles.
                                <a href="@Url.Action("ListadoCategorias", "Categoria")" style="color: var(--primary-color); text-decoration: underline;">Ver categorías</a>
                            </small>
                        }

                        @Html.ValidationMessageFor(model => model.IdCategoria, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                    </div>

                    <!-- Descripción -->
                    <div style="margin-bottom: 1.5rem;">
                        @Html.LabelFor(model => model.DescripcionProducto, new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;" })
                        @Html.TextAreaFor(model => model.DescripcionProducto, new { @class = "form-control", rows = "3", placeholder = "Descripción detallada del producto...", style = "width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s; resize: vertical;" })
                        @Html.ValidationMessageFor(model => model.DescripcionProducto, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                    </div>

                    <!-- Cantidad y Precio -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div>
                            @Html.LabelFor(model => model.Cantidad, new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;" })
                            @Html.EditorFor(model => model.Cantidad, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", placeholder = "0", style = "width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s;" } })
                            @Html.ValidationMessageFor(model => model.Cantidad, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                        </div>

                        <div>
                            @Html.LabelFor(model => model.Precio, new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;" })
                            <input type="text"
                                   name="PrecioStr"
                                   id="Precio"
                                   value="@Model.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control"
                                   placeholder="0.00"
                                   style="width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s;" />
                            @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                        </div>
                    </div>

                    <!-- Descuento e Impuesto -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <!-- Porcentaje de Descuento (OPCIONAL) -->
                        <div>
                            @Html.LabelFor(model => model.PorcentajeDescuento, "Descuento (%)", new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;" })
                            <input type="text"
                                   name="PorcentajeDescuentoStr"
                                   id="PorcentajeDescuento"
                                   value="@(Model.PorcentajeDescuento.HasValue? Model.PorcentajeDescuento.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                   class="form-control"
                                   placeholder="0.00"
                                   style="width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s;" />
                            @Html.ValidationMessageFor(model => model.PorcentajeDescuento, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                            <small style="color: var(--text-color); font-size: 0.85rem; margin-top: 0.3rem; display: block;">
                                <i class="fas fa-info-circle" style="color: var(--primary-color);"></i> Opcional. Dejar vacío o en 0 si no aplica.
                            </small>
                        </div>

                        <!-- Porcentaje de Impuesto -->
                        <div>
                            @Html.LabelFor(model => model.PorcentajeImpuesto, "Impuesto (%)", new { @class = "form-label", style = "display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;" })
                            <input type="text"
                                   name="PorcentajeImpuestoStr"
                                   id="PorcentajeImpuesto"
                                   value="@Model.PorcentajeImpuesto.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control"
                                   placeholder="13.00"
                                   style="width: 100%; padding: 0.8rem 1rem; border: 2px solid var(--secondary-color); border-radius: 10px; font-size: 1rem; transition: all 0.3s;" />
                            @Html.ValidationMessageFor(model => model.PorcentajeImpuesto, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                            <small style="color: var(--text-color); font-size: 0.85rem; margin-top: 0.3rem; display: block;">
                                <i class="fas fa-info-circle" style="color: var(--primary-color);"></i> Ej: 13 para 13%
                            </small>
                        </div>
                    </div>

                    <!-- Imagen del Producto -->
                    <div style="margin-bottom: 1.5rem;">
                        <label class="form-label" style="display: block; margin-bottom: 0.5rem; color: var(--dark-color); font-weight: 500;">
                            <i class="fas fa-image" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                            Cambiar Imagen del Producto (Opcional)
                        </label>

                        <!-- Imagen actual -->
                        @if (Model.Imagen != null && Model.Imagen.Length > 0)
                        {
                            <div style="margin-bottom: 1rem; text-align: center;">
                                <p style="color: var(--text-color); margin-bottom: 0.5rem; font-weight: 500;">Imagen actual:</p>
                                <img src="@Url.Action("ObtenerImagenProducto", "Producto", new { id = Model.IdProducto })"
                                     alt="@Model.NombreProducto"
                                     style="max-width: 200px; max-height: 200px; border-radius: 10px; box-shadow: var(--shadow); object-fit: cover;" />
                            </div>
                        }

                        <div style="border: 2px dashed var(--secondary-color); border-radius: 10px; padding: 2rem; text-align: center; background: var(--light-color); transition: all 0.3s;" id="dropZone">
                            <i class="fas fa-cloud-upload-alt" style="font-size: 3rem; color: var(--primary-color); opacity: 0.5; margin-bottom: 1rem; display: block;"></i>
                            <input type="file" name="archivo" id="archivoImagen" accept="image/*" style="display: block; margin: 0 auto; padding: 0.5rem; border: 2px solid var(--secondary-color); border-radius: 5px; cursor: pointer;" />
                            <p style="color: var(--text-color); margin-top: 0.5rem; font-size: 0.9rem;">Dejar vacío para mantener la imagen actual</p>
                            <div id="preview" style="margin-top: 1rem;"></div>
                            <div id="fileName" style="margin-top: 0.5rem; color: var(--primary-color); font-weight: 600;"></div>
                            <small style="display: block; margin-top: 1rem; color: var(--text-color); font-size: 0.85rem;">
                                <i class="fas fa-info-circle" style="color: var(--primary-color);"></i>
                                Formatos: JPG, JPEG, PNG, GIF, BMP | Tamaño máximo: 5MB
                            </small>
                        </div>
                    </div>

                    <!-- Estado del Producto -->
                    <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--light-color); border-radius: 10px; border: 2px solid var(--secondary-color);">
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "form-check-input", id = "estadoCheckbox", style = "width: 50px; height: 25px; cursor: pointer;" } })
                            @Html.LabelFor(model => model.Estado, "Estado del Producto (Activo/Inactivo)", new { @class = "form-check-label", @for = "estadoCheckbox", style = "color: var(--dark-color); font-weight: 500; cursor: pointer; margin: 0;" })
                        </div>
                        @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger", style = "color: #c33; font-size: 0.9rem; margin-top: 0.3rem; display: block;" })
                        <small style="color: var(--text-color); font-size: 0.85rem; margin-top: 0.5rem; display: block;">
                            <i class="fas fa-toggle-on" style="color: var(--primary-color);"></i> Activa o desactiva la disponibilidad del producto
                        </small>
                    </div>
                }
            </div>

            <!-- Footer del formulario -->
            <div style="padding: 1.5rem 2rem; background: var(--light-color); display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--secondary-color); gap: 1rem; flex-wrap: wrap;">
                <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("ListadoProductos", "Producto")'" style="display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="submit" class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem; background: #27ae60;">
                    <i class="fas fa-check"></i> @(soloStock ? "Actualizar Stock" : "Guardar Cambios")
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/producto.js"></script>
}