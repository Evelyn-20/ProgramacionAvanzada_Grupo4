@model List<Pasteleria.Abstracciones.ModeloUI.Categoria>

@{
    ViewBag.Title = "Categorías";

    // Permisos basados en la tabla
    var tipoUsuario = User.FindFirst("TipoUsuario")?.Value;

    // Ver/Crear/Editar: Admin, Operaciones, Supervisor, Operador
    var puedeGestionar = tipoUsuario == "Administrador" ||
                         tipoUsuario == "Operaciones" ||
                         tipoUsuario == "Supervisor" ||
                         tipoUsuario == "Operador";

    // Eliminar: Solo Admin
    var puedeEliminar = tipoUsuario == "Administrador";
}

<!-- Banner Hero -->
<section class="hero" style="padding: 3rem 0;">
    <div class="hero-content">
        <h1 class="hero-title">Categorías</h1>
        <p class="hero-subtitle">Administra y visualiza todas las categorías de productos</p>
    </div>
</section>

<div class="container" style="padding: 3rem 20px; max-width: 1400px;">
    <!-- Mensajes de éxito/error -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; margin-bottom: 2rem;">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 10px; margin-bottom: 2rem;">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!puedeGestionar)
    {
        <div class="alert alert-warning" role="alert" style="border-radius: 10px; margin-bottom: 2rem;">
            <i class="fas fa-exclamation-circle"></i> No tienes permisos para gestionar categorías.
        </div>
        return;
    }

    <!-- Barra de búsqueda y botón agregar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap;">
        <form method="get" action="@Url.Action("ListadoCategorias", "Categoria")" style="position: relative; flex: 1; min-width: 300px; display: flex; gap: 0.5rem;">
            <div style="position: relative; flex: 1;">
                <i class="fas fa-search" style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: var(--primary-color); z-index: 1;"></i>
                <input type="text"
                       id="buscar"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       placeholder="Buscar por nombre..."
                       style="width: 100%; padding: 1rem 1rem 1rem 50px; border: 2px solid var(--secondary-color); border-radius: 50px; font-size: 1rem; background: var(--white); transition: all 0.3s;">
            </div>
            <button type="submit" class="btn btn-primary" style="border-radius: 50px; padding: 0 2rem;">
                <i class="fas fa-search"></i> Buscar
            </button>
        </form>

        @* Botón Crear: Todos los que pueden gestionar *@
        @if (puedeGestionar)
        {
            <a href="@Url.Action("CrearCategoria", "Categoria")" class="btn btn-primary" style="white-space: nowrap;">
                <i class="fas fa-plus"></i> Agregar Categoría
            </a>
        }
    </div>

    <!-- Tabla con estilo mejorado -->
    <div style="background: var(--white); border-radius: 15px; box-shadow: var(--shadow); overflow: hidden;">
        <div class="table-responsive">
            <table id="laTablaDeCategor" style="margin-bottom: 0; width: 100%; border-collapse: collapse;">
                <thead style="background: linear-gradient(135deg, var(--secondary-color) 0%, #e8d4bc 100%);">
                    <tr>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">#</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Imagen</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Nombre</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none;">Estado</th>
                        <th style="padding: 1.2rem; color: var(--dark-color); font-weight: 600; border: none; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var categoria in Model)
                        {
                            <tr style="border-bottom: 1px solid var(--secondary-color); transition: background 0.3s;"
                                onmouseover="this.style.background='var(--light-color)'"
                                onmouseout="this.style.background='transparent'">
                                <td style="padding: 1.2rem; color: var(--text-color);">@categoria.IdCategoria</td>
                                <td style="padding: 1.2rem;">
                                    <img src="@Url.Action("ObtenerThumbnailCategoria", "Categoria", new { id = categoria.IdCategoria })" alt="@categoria.NombreCategoria"
                                         onerror="this.src='/images/placeholder.png'" loading="lazy" style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px; box-shadow: var(--shadow);">
                                </td>
                                <td style="padding: 1.2rem; color: var(--dark-color); font-weight: 500;">@categoria.NombreCategoria</td>
                                <td style="padding: 1.2rem;">
                                    @if (categoria.Estado)
                                    {
                                        <span style="background: #27ae60; color: var(--white); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block;">Activo</span>
                                    }
                                    else
                                    {
                                        <span style="background: #e74c3c; color: var(--white); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block;">Inactivo</span>
                                    }
                                </td>
                                <td style="padding: 1.2rem; text-align: center; white-space: nowrap;">
                                    @* Botón Editar: Todos los que pueden gestionar *@
                                    @if (puedeGestionar)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-editar"
                                                data-id="@categoria.IdCategoria"
                                                style="background: var(--primary-color); color: var(--white); border: none; margin: 0 0.25rem; cursor: pointer;"
                                                title="Editar categoría">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    }

                                    @* Botón Ver Detalles: Todos los que pueden gestionar *@
                                    <button type="button"
                                            class="btn btn-sm btn-detalles"
                                            data-id="@categoria.IdCategoria"
                                            data-nombre="@categoria.NombreCategoria"
                                            data-estado="@(categoria.Estado ? "Activo" : "Inactivo")"
                                            style="background: #3498db; color: var(--white); border: none; margin: 0 0.25rem; cursor: pointer;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalDetallesCategoria"
                                            title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </button>

                                    @* Botón Eliminar: Solo Admin *@
                                    @if (puedeEliminar)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-eliminar"
                                                data-id="@categoria.IdCategoria"
                                                data-nombre="@categoria.NombreCategoria"
                                                data-estado="@(categoria.Estado ? "Activo" : "Inactivo")"
                                                style="background: #e74c3c; color: var(--white); border: none; margin: 0 0.25rem; cursor: pointer;"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminarCategoria"
                                                title="Eliminar categoría">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="padding: 3rem; text-align: center; color: var(--text-color);">
                                <i class="fas fa-inbox" style="font-size: 3rem; color: var(--secondary-color); opacity: 0.5; display: block; margin-bottom: 1rem;"></i>
                                <p style="font-size: 1.2rem; margin: 0;">No se encontraron categorías</p>
                                @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
                                {
                                    <p style="margin-top: 0.5rem;">
                                        <a href="@Url.Action("ListadoCategorias", "Categoria")" style="color: var(--primary-color);">Limpiar filtros</a>
                                    </p>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <!-- Footer de paginación -->
            <div style="padding: 1.5rem; background: var(--light-color); display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--secondary-color); flex-wrap: wrap; gap: 1rem;">
                <div style="color: var(--text-color); font-size: 0.95rem;">
                    Mostrando <strong><span id="startRecord">1</span>-<span id="endRecord">@Math.Min(5, Model.Count)</span></strong> de <strong id="totalRecords">@Model.Count</strong> categorías
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button id="btnAnterior"
                            class="btn"
                            onclick="paginaAnterior()"
                            style="border-radius: 50px; background: transparent; color: var(--primary-color); border: 2px solid var(--primary-color); padding: 0.8rem 2rem;">
                        &lt; Anterior
                    </button>
                    <button id="btnSiguiente"
                            class="btn"
                            onclick="paginaSiguiente()"
                            style="border-radius: 50px; background: var(--primary-color); color: var(--white); border: none; padding: 0.8rem 2rem;">
                        Siguiente &gt;
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<partial name="_ModalDetallesCategoria" />
@if (puedeEliminar)
{
    <partial name="_ModalEliminarCategoria" />
}

@section Scripts {
    <script>
        // Variables globales de paginación
        var paginaActual = 1;
        var registrosPorPagina = 10;
        var todasLasFilas = [];

        document.addEventListener('DOMContentLoaded', function () {
            console.log('Inicializando categorías...');

            // Inicializar tabla
            var table = document.getElementById('laTablaDeCategor');
            if (table && table.getElementsByTagName('tbody')[0]) {
                todasLasFilas = Array.from(table.getElementsByTagName('tbody')[0].getElementsByTagName('tr'));
                console.log('Filas encontradas:', todasLasFilas.length);
                if (todasLasFilas.length > 0 && !todasLasFilas[0].querySelector('td[colspan]')) {
                    mostrarPagina(paginaActual);
                }
            }

            // Boton de Editar
            document.addEventListener('click', function(e) {
                if (e.target.closest('.btn-editar')) {
                    e.preventDefault();
                    var btn = e.target.closest('.btn-editar');
                    var id = btn.getAttribute('data-id');
                    console.log('Editando categoría:', id);
                    window.location.href = '/Categoria/EditarCategoria?id=' + id;
                }
            });

            // Boton de detalles
            var botonesDetalles = document.querySelectorAll('.btn-detalles');
            botonesDetalles.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    var nombre = this.getAttribute('data-nombre');
                    var estado = this.getAttribute('data-estado');

                    document.getElementById('detalles-id').textContent = id;
                    document.getElementById('detalles-nombre').textContent = nombre;
                    document.getElementById('detalles-imagen').src = '/Categoria/ObtenerImagenCategoria?id=' + id;

                    var badge = document.getElementById('detalles-estado-badge');
                    badge.textContent = estado;
                    badge.style.background = estado === 'Activo' ? '#27ae60' : '#e74c3c';
                    badge.style.color = 'white';
                    badge.style.padding = '0.5rem 1rem';
                    badge.style.borderRadius = '20px';
                });
            });

            // Boton de eliminar
            var botonesEliminar = document.querySelectorAll('.btn-eliminar');
            botonesEliminar.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    var nombre = this.getAttribute('data-nombre');
                    var estado = this.getAttribute('data-estado');

                    document.getElementById('eliminar-id').value = id;
                    document.getElementById('eliminar-id-display').textContent = id;
                    document.getElementById('eliminar-nombre').textContent = nombre;

                    var badge = document.getElementById('eliminar-estado-badge');
                    badge.textContent = estado;
                    badge.style.background = estado === 'Activo' ? '#27ae60' : '#e74c3c';
                    badge.style.color = 'white';
                    badge.style.padding = '0.5rem 1rem';
                    badge.style.borderRadius = '20px';

                    document.getElementById('formEliminarCategoria').action = '/Categoria/EliminarCategoria';
                });
            });
        });

        function mostrarPagina(pagina) {
            if (todasLasFilas.length === 0) return;

            var inicio = (pagina - 1) * registrosPorPagina;
            var fin = inicio + registrosPorPagina;
            var totalRegistros = todasLasFilas.length;

            todasLasFilas.forEach(function (row, index) {
                row.style.display = (index >= inicio && index < fin) ? '' : 'none';
            });

            document.getElementById('startRecord').textContent = inicio + 1;
            document.getElementById('endRecord').textContent = Math.min(fin, totalRegistros);
            document.getElementById('totalRecords').textContent = totalRegistros;

            var btnAnterior = document.getElementById('btnAnterior');
            var btnSiguiente = document.getElementById('btnSiguiente');

            if (btnAnterior) {
                btnAnterior.disabled = pagina === 1;
                btnAnterior.style.opacity = pagina === 1 ? '0.5' : '1';
            }

            if (btnSiguiente) {
                var deshabilitado = fin >= totalRegistros;
                btnSiguiente.disabled = deshabilitado;
                btnSiguiente.style.opacity = deshabilitado ? '0.5' : '1';
            }
        }

        function paginaAnterior() {
            if (paginaActual > 1) {
                paginaActual--;
                mostrarPagina(paginaActual);
            }
        }

        function paginaSiguiente() {
            var totalPaginas = Math.ceil(todasLasFilas.length / registrosPorPagina);
            if (paginaActual < totalPaginas) {
                paginaActual++;
                mostrarPagina(paginaActual);
            }
        }
    </script>
}