<div class="modal fade" id="modalDetallesPedidoCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border: none; border-radius: 15px; overflow: hidden; box-shadow: var(--shadow-lg);">
            <div class="modal-header" style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); color: var(--white); border: none; padding: 1.5rem 2rem;">
                <h5 class="modal-title" style="font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-shopping-cart"></i> Detalles de tu Pedido
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 2rem; background: var(--white);">
                <div style="background: var(--light-color); padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem; border-left: 4px solid #3498db;">
                    <h5 style="color: var(--dark-color); margin: 0; font-size: 1.5rem;">
                        Pedido #<span id="cliente-pedido-id"></span>
                    </h5>
                    <p style="margin: 0.5rem 0 0 0; color: var(--text-color);">
                        <i class="fas fa-calendar"></i> <span id="cliente-pedido-fecha"></span>
                    </p>
                </div>

                <!-- Estado del pedido -->
                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; color: var(--text-color); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.5rem;">
                        <i class="fas fa-toggle-on" style="color: var(--primary-color); margin-right: 0.5rem;"></i> Estado
                    </label>
                    <span id="cliente-pedido-estado-badge" style="padding: 0.5rem 1rem; border-radius: 20px; display: inline-block; font-weight: 600;"></span>
                </div>

                <!-- Productos del Pedido -->
                <div>
                    <label style="display: block; color: var(--text-color); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.5rem;">
                        <i class="fas fa-box" style="color: var(--primary-color); margin-right: 0.5rem;"></i> Productos
                    </label>
                    <div id="cliente-pedido-productos" style="background: var(--light-color); border-radius: 10px; padding: 1rem; max-height: 300px; overflow-y: auto;">
                        <!-- Los productos se cargarán dinámicamente -->
                    </div>
                </div>

                <!-- Sección de Totales -->
                <div style="background: var(--light-color); padding: 1rem; border-radius: 10px; margin-top: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span style="color: var(--text-color);">Subtotal:</span>
                        <span id="cliente-pedido-subtotal" style="color: var(--dark-color); font-weight: 600;"></span>
                    </div>
                    <div id="cliente-pedido-descuento-row" style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span style="color: var(--text-color);">Descuento:</span>
                        <span id="cliente-pedido-descuento" style="color: #27ae60; font-weight: 600;"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--secondary-color);">
                        <span style="color: var(--text-color);">Impuesto (13%):</span>
                        <span id="cliente-pedido-impuesto" style="color: var(--dark-color); font-weight: 600;"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--dark-color); font-weight: 700; font-size: 1.2rem;">
                            <i class="fas fa-dollar-sign" style="color: var(--primary-color); margin-right: 0.5rem;"></i> Total
                        </span>
                        <span id="cliente-pedido-total" style="color: var(--primary-color); font-size: 1.3rem; font-weight: 700;"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background: var(--light-color); border: none; padding: 1.5rem 2rem;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 50px;">
                    <i class="fas fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>