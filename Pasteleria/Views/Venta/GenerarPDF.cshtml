

@{
    ViewData["Title"] = "Reporte de Ventas";
}

<h2>Reporte de Ventas</h2>

<div class="card p-4" style="max-width: 600px;">
    <form method="post" action="/Venta/GenerarPDFResult">

        <div class="form-group">
            <label>Fecha Inicio</label>
            <input type="date" name="FechaInicio" class="form-control" required />
        </div>

        <div class="form-group mt-3">
            <label>Fecha Fin</label>
            <input type="date" name="FechaFin" class="form-control" required />
        </div>

        <div class="form-group">
            <label>Cliente</label>
            <select name="IdCliente" class="form-control">
                <option value="">-- Todos --</option>

                @foreach (Pasteleria.Abstracciones.ModeloUI.Cliente c in (IEnumerable<Pasteleria.Abstracciones.ModeloUI.Cliente>)ViewBag.Clientes)
                {
                    <option value="@c.IdCliente">@c.NombreCliente</option>
                }
            </select>


        </div>

        <div class="form-group">
            <label>Usuario</label>
            <select name="IdUsuario" class="form-control">
                <option value="">-- Todos --</option>

                @foreach (Pasteleria.Abstracciones.ModeloUI.Usuario u in (IEnumerable<Pasteleria.Abstracciones.ModeloUI.Usuario>)ViewBag.Usuarios)
                {
                    <option value="@u.IdUsuario">@u.NombreUsuario</option>
                }
            </select>



        </div>


        <button type="submit" class="btn btn-primary mt-4">
            <i class="fas fa-file-pdf"></i> Generar PDF
        </button>
    </form>
</div>
