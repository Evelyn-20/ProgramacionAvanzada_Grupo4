@model List<Pasteleria.Controllers.ReportePedidoDetalle>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte de Pedidos</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/reporte.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        @{
            var fechaInicio = ViewBag.FechaInicio?.ToString() ?? "N/A";
            var fechaFin = ViewBag.FechaFin?.ToString() ?? "N/A";
            var fechaGeneracion = ViewBag.FechaGeneracion?.ToString() ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
            var totalPedidos = ViewBag.TotalPedidos ?? 0;
            var totalGeneral = ViewBag.TotalGeneral ?? 0m;
            var totalProductos = ViewBag.TotalProductos ?? 0;
        }

        <!-- Header -->
        <div class="header">
            <h1><i class="fas fa-birthday-cake"></i> REPORTE DE PEDIDOS</h1>
            <div class="subtitle">Generado: @fechaGeneracion</div>
        </div>

        <!-- Información del Reporte -->
        <div class="info-section">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label"><i class="fas fa-calendar-alt" style="color: #e67e73; margin-right: 5px;"></i> Fecha de Generación:</span>
                    <span class="info-value">@fechaGeneracion</span>
                </div>
                @{
                    var filtroEstado = ViewBag.FiltroEstado?.ToString();
                    if (!string.IsNullOrWhiteSpace(filtroEstado) && filtroEstado != "Todos")
                    {
                        <div class="info-item">
                            <span class="info-label">Estado Filtrado:</span>
                            <span class="info-value">@filtroEstado</span>
                        </div>
                    }

                    var filtroCliente = ViewBag.FiltroCliente?.ToString();
                    if (!string.IsNullOrWhiteSpace(filtroCliente))
                    {
                        <div class="info-item">
                            <span class="info-label">Cliente Filtrado:</span>
                            <span class="info-value">@filtroCliente</span>
                        </div>
                    }

                    var filtroUsuario = ViewBag.FiltroUsuario?.ToString();
                    if (!string.IsNullOrWhiteSpace(filtroUsuario))
                    {
                        <div class="info-item">
                            <span class="info-label">Usuario Filtrado:</span>
                            <span class="info-value">@filtroUsuario</span>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Listado de Pedidos -->
        @if (Model != null && Model.Count > 0)
        {
            @for (int i = 0; i < Model.Count; i++)
            {
                var reporte = Model[i];

                <div class="pedido-card">
                    <div class="pedido-header">
                        <div class="pedido-header-content">
                            <div>
                                <div class="pedido-title">
                                    <i class="fas fa-receipt" style="color: #e67e73; margin-right: 5px;"></i> Pedido #@reporte.Pedido.IdPedido
                                </div>
                                <div class="pedido-meta">
                                    <i class="fas fa-user" style="color: #e67e73; margin-right: 3px;"></i> <strong>Cliente:</strong> @reporte.Pedido.NombreCliente |
                                    <i class="fas fa-calendar" style="color: #e67e73; margin-right: 3px;"></i> <strong>Fecha:</strong> @reporte.Pedido.FechaPedidoFormateada |
                                    @{
                                        var estadoClass = "";
                                        switch (reporte.Pedido.Estado)
                                        {
                                            case "Pendiente": estadoClass = "estado-pendiente"; break;
                                            case "En Proceso": estadoClass = "estado-proceso"; break;
                                            case "Completado": estadoClass = "estado-completado"; break;
                                            case "Cancelado": estadoClass = "estado-cancelado"; break;
                                            case "Entregado": estadoClass = "estado-entregado"; break;
                                        }
                                    }
                                    <span class="estado-badge @estadoClass">@reporte.Pedido.Estado</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(reporte.Pedido.NombreUsuario))
                                {
                                    <div class="pedido-meta">
                                        <i class="fas fa-user-tie" style="color: #e67e73; margin-right: 3px;"></i> <strong>Procesado por:</strong> @reporte.Pedido.NombreUsuario
                                    </div>
                                }
                            </div>
                            <div class="pedido-total-box">
                                <div class="pedido-total-label">Total</div>
                                <div class="pedido-total-value">₡@reporte.Pedido.Total.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    <div class="pedido-body">
                        <div class="productos-title"><i class="fas fa-box-open" style="color: #e67e73; margin-right: 5px;"></i> Productos del Pedido</div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-right">Precio Unit.</th>
                                    <th class="text-right">Descuento</th>
                                    <th class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in reporte.Detalles)
                                {
                                    <tr>
                                        <td><strong>@detalle.NombreProducto</strong></td>
                                        <td class="text-center">@detalle.Cantidad</td>
                                        <td class="text-right">₡@detalle.Precio.ToString("N2")</td>
                                        <td class="text-right" style="color: #27ae60;">
                                            @if (detalle.Descuento > 0)
                                            {
                                                <span>-₡@detalle.Descuento.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td class="text-right"><strong>₡@detalle.Subtotal.ToString("N2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="totals-box">
                            <div class="totals-row">
                                <span>Subtotal:</span>
                                <span>₡@reporte.Pedido.Subtotal.ToString("N2")</span>
                            </div>
                            @if (reporte.Pedido.Descuento.HasValue && reporte.Pedido.Descuento > 0)
                            {
                                <div class="totals-row" style="color: #27ae06;">
                                    <span>Descuento:</span>
                                    <span>-₡@reporte.Pedido.Descuento.Value.ToString("N2")</span>
                                </div>
                            }
                            @if (reporte.Pedido.Impuesto.HasValue && reporte.Pedido.Impuesto > 0)
                            {
                                <div class="totals-row">
                                    <span>Impuesto (13%):</span>
                                    <span>₡@reporte.Pedido.Impuesto.Value.ToString("N2")</span>
                                </div>
                            }
                            <div class="totals-row final">
                                <span>TOTAL:</span>
                                <span style="color: #e67e73;">₡@reporte.Pedido.Total.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (i % 2 == 1 && i < Model.Count - 1)
                {
                    <div class="page-break"></div>
                }
            }
        }
        else
        {
            <div class="no-data">
                <p style="font-size: 14px; color: #666;">No se encontraron pedidos que coincidan con los filtros seleccionados.</p>
            </div>
        }

        <!-- Footer Info -->
        <div class="footer-info">
            <p><strong><i class="fas fa-birthday-cake" style="color: #e67e73; margin-right: 5px;"></i> Pastelería - Sistema de Gestión de Pedidos</strong></p>
            <p>Documento generado automáticamente - Confidencial</p>
        </div>
    </div>
</body>
</html>